# Store files byte-for-byte; Unity manages its own line endings.
* -text

# Diff drivers for source
*.cs   diff=csharp
*.md   diff=markdown

# Unity YAML assets: treat as text for diffs, merge with UnityYAMLMerge if configured
*.unity     merge=unityyamlmerge linguist-generated
*.prefab    merge=unityyamlmerge linguist-generated
*.asset     merge=unityyamlmerge linguist-generated
*.mat       merge=unityyamlmerge linguist-generated
*.anim      merge=unityyamlmerge linguist-generated
*.controller merge=unityyamlmerge linguist-generated
*.meta      linguist-generated

# Binary assets
*.fbx  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.psd  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
*.zip  binary
*.so   binary
*.aar  binary
*.task binary
*.fst  binary

# Files over GitHub's 100 MB limit go through Git LFS
Assets/Models/Comic_Vibrant_Elevator_System_T77/Comic_Vibrant_Elevator_System_T77.fbx filter=lfs diff=lfs merge=lfs -text
