      textVN: "V\u1EA5n \u0111\u1EC1 t\u1EA1m th\u1EDDi"
      side: 
    - id: D
      text: "V\u1EA5n \u0111\u1EC1 ch\u1EC9 c\u1EE7a m\u1ED9t giai c\u1EA5p"
      textVN: "V\u1EA5n \u0111\u1EC1 ch\u1EC9 c\u1EE7a m\u1ED9t giai c\u1EA5p"
