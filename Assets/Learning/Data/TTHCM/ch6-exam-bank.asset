      text: "Ch\xEDnh tr\u1ECB ph\u1EE5 thu\u1ED9c v\u0103n h\xF3a ho\xE0n to\xE0n"
      textVN: "Ch\xEDnh tr\u1ECB ph\u1EE5 thu\u1ED9c v\u0103n h\xF3a ho\xE0n to\xE0n"
      side: 
    - id: D
      text: "Hai l\u0129nh v\u1EF1c \u0111\u1ED1i l\u1EADp"
      textVN: "Hai l\u0129nh v\u1EF1c \u0111\u1ED1i l\u1EADp"
