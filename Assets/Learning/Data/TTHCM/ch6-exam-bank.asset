  - id: ch6-ex-03
    type: single-choice
    lessonId: 
    topic: 
    difficulty: 2
    tags: []
    source: GT 2021, tr. 209
    chapterId: tthcm-ch6
    prompt: "V\u0103n h\xF3a gi\u1EEF vai tr\xF2 g\xEC v\u1EDBi ch\xEDnh tr\u1ECB theo H\u1ED3 Ch\xED Minh?"
    explanation: "M\u1ECDi ho\u1EA1t \u0111\u1ED9ng c\u1EE7a t\u1ED5 ch\u1EE9c v\xE0 nh\xE0 ch\xEDnh tr\u1ECB ph\u1EA3i c\xF3 h\xE0m l\u01B0\u1EE3ng v\u0103n h\xF3a."
    promptVN: "V\u0103n h\xF3a gi\u1EEF vai tr\xF2 g\xEC v\u1EDBi ch\xEDnh tr\u1ECB theo H\u1ED3 Ch\xED Minh?"
    explanationVN: "M\u1ECDi ho\u1EA1t \u0111\u1ED9ng c\u1EE7a t\u1ED5 ch\u1EE9c v\xE0 nh\xE0 ch\xEDnh tr\u1ECB ph\u1EA3i c\xF3 h\xE0m l\u01B0\u1EE3ng v\u0103n h\xF3a."
    options:
    - id: A
      text: "V\u0103n h\xF3a ph\u1EA3i \u1EDF trong ch\xEDnh tr\u1ECB, ph\u1EE5c v\u1EE5 nhi\u1EC7m v\u1EE5 ch\xEDnh tr\u1ECB"
      textVN: "V\u0103n h\xF3a ph\u1EA3i \u1EDF trong ch\xEDnh tr\u1ECB, ph\u1EE5c v\u1EE5 nhi\u1EC7m v\u1EE5 ch\xEDnh tr\u1ECB"
      side: 
    - id: B
      text: "V\u0103n h\xF3a \u0111\u1EE9ng ngo\xE0i ch\xEDnh tr\u1ECB"
      textVN: "V\u0103n h\xF3a \u0111\u1EE9ng ngo\xE0i ch\xEDnh tr\u1ECB"
      side: 
