  id: ch1-b2
  title: "\u0110\u1ED1i t\u01B0\u1EE3ng nghi\xEAn c\u1EE9u"
  topic: "\u0110\u1ED1i t\u01B0\u1EE3ng nghi\xEAn c\u1EE9u"
  titleVN: "\u0110\u1ED1i t\u01B0\u1EE3ng nghi\xEAn c\u1EE9u"
  pages:
  - title: "\u0110\u1ED1i t\u01B0\u1EE3ng nghi\xEAn c\u1EE9u c\u1EE7a m\xF4n h\u1ECDc"
    titleVN: "\u0110\u1ED1i t\u01B0\u1EE3ng nghi\xEAn c\u1EE9u c\u1EE7a m\xF4n h\u1ECDc"
    contentVN: "M\xF4n h\u1ECDc T\u01B0 t\u01B0\u1EDFng H\u1ED3 Ch\xED Minh l\xE0 m\u1ED9t n\u1ED9i dung c\u1EE7a chuy\xEAn ng\xE0nh H\u1ED3 Ch\xED Minh h\u1ECDc (n\u1EB1m trong ng\xE0nh Khoa h\u1ECDc ch\xEDnh tr\u1ECB). \u0110\u1ED1i t\u01B0\u1EE3ng nghi\xEAn c\u1EE9u c\u1EE7a m\xF4n h\u1ECDc l\xE0 to\xE0n b\u1ED9 nh\u1EEFng quan \u0111i\u1EC3m c\u1EE7a H\u1ED3 Ch\xED Minh th\u1EC3 hi\u1EC7n trong di s\u1EA3n c\u1EE7a Ng\u01B0\u1EDDi. \u0110\xF3 l\xE0 h\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m to\xE0n di\u1EC7n v\xE0 s\xE2u s\u1EAFc v\u1EC1 nh\u1EEFng v\u1EA5n \u0111\u1EC1 c\u01A1 b\u1EA3n c\u1EE7a c\xE1ch m\u1EA1ng Vi\u1EC7t Nam.\n\nH\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m \u1EA5y \u0111\u01B0\u1EE3c ph\u1EA3n \xE1nh trong nh\u1EEFng b\xE0i n\xF3i, b\xE0i vi\u1EBFt, trong ho\u1EA1t \u0111\u1ED9ng c\xE1ch m\u1EA1ng v\xE0 trong cu\u1ED9c s\u1ED1ng h\u1EB1ng ng\xE0y c\u1EE7a Ng\u01B0\u1EDDi. \u0110\xF3 l\xE0 nh\u1EEFng v\u1EA5n \u0111\u1EC1 l\xFD lu\u1EADn v\xE0 th\u1EF1c ti\u1EC5n \u0111\u01B0\u1EE3c r\xFAt ra t\u1EEB cu\u1ED9c \u0111\u1EDDi ho\u1EA1t \u0111\u1ED9ng r\u1EA5t phong ph\xFA \u1EDF c\u1EA3 trong n\u01B0\u1EDBc v\xE0 tr\xEAn th\u1EBF gi\u1EDBi c\u1EE7a H\u1ED3 Ch\xED Minh, ph\u1EA5n \u0111\u1EA5u cho s\u1EF1 nghi\u1EC7p gi\u1EA3i ph\xF3ng d\xE2n t\u1ED9c, gi\u1EA3i ph\xF3ng x\xE3 h\u1ED9i, gi\u1EA3i ph\xF3ng giai c\u1EA5p, gi\u1EA3i ph\xF3ng con ng\u01B0\u1EDDi. (Gi\xE1o tr\xECnh 2021, tr.19-20)"
    exampleVN: 
    takeawayVN: "\u0110\u1ED1i t\u01B0\u1EE3ng nghi\xEAn c\u1EE9u: to\xE0n b\u1ED9 quan \u0111i\u1EC3m c\u1EE7a H\u1ED3 Ch\xED Minh th\u1EC3 hi\u1EC7n trong di s\u1EA3n c\u1EE7a Ng\u01B0\u1EDDi."
    content: "M\xF4n h\u1ECDc T\u01B0 t\u01B0\u1EDFng H\u1ED3 Ch\xED Minh l\xE0 m\u1ED9t n\u1ED9i dung c\u1EE7a chuy\xEAn ng\xE0nh H\u1ED3 Ch\xED Minh h\u1ECDc (n\u1EB1m trong ng\xE0nh Khoa h\u1ECDc ch\xEDnh tr\u1ECB). \u0110\u1ED1i t\u01B0\u1EE3ng nghi\xEAn c\u1EE9u c\u1EE7a m\xF4n h\u1ECDc l\xE0 to\xE0n b\u1ED9 nh\u1EEFng quan \u0111i\u1EC3m c\u1EE7a H\u1ED3 Ch\xED Minh th\u1EC3 hi\u1EC7n trong di s\u1EA3n c\u1EE7a Ng\u01B0\u1EDDi. \u0110\xF3 l\xE0 h\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m to\xE0n di\u1EC7n v\xE0 s\xE2u s\u1EAFc v\u1EC1 nh\u1EEFng v\u1EA5n \u0111\u1EC1 c\u01A1 b\u1EA3n c\u1EE7a c\xE1ch m\u1EA1ng Vi\u1EC7t Nam.\n\nH\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m \u1EA5y \u0111\u01B0\u1EE3c ph\u1EA3n \xE1nh trong nh\u1EEFng b\xE0i n\xF3i, b\xE0i vi\u1EBFt, trong ho\u1EA1t \u0111\u1ED9ng c\xE1ch m\u1EA1ng v\xE0 trong cu\u1ED9c s\u1ED1ng h\u1EB1ng ng\xE0y c\u1EE7a Ng\u01B0\u1EDDi. \u0110\xF3 l\xE0 nh\u1EEFng v\u1EA5n \u0111\u1EC1 l\xFD lu\u1EADn v\xE0 th\u1EF1c ti\u1EC5n \u0111\u01B0\u1EE3c r\xFAt ra t\u1EEB cu\u1ED9c \u0111\u1EDDi ho\u1EA1t \u0111\u1ED9ng r\u1EA5t phong ph\xFA \u1EDF c\u1EA3 trong n\u01B0\u1EDBc v\xE0 tr\xEAn th\u1EBF gi\u1EDBi c\u1EE7a H\u1ED3 Ch\xED Minh, ph\u1EA5n \u0111\u1EA5u cho s\u1EF1 nghi\u1EC7p gi\u1EA3i ph\xF3ng d\xE2n t\u1ED9c, gi\u1EA3i ph\xF3ng x\xE3 h\u1ED9i, gi\u1EA3i ph\xF3ng giai c\u1EA5p, gi\u1EA3i ph\xF3ng con ng\u01B0\u1EDDi. (Gi\xE1o tr\xECnh 2021, tr.19-20)"
    example: 
    takeaway: "\u0110\u1ED1i t\u01B0\u1EE3ng nghi\xEAn c\u1EE9u: to\xE0n b\u1ED9 quan \u0111i\u1EC3m c\u1EE7a H\u1ED3 Ch\xED Minh th\u1EC3 hi\u1EC7n trong di s\u1EA3n c\u1EE7a Ng\u01B0\u1EDDi."
    illustration: {fileID: 0}
  - title: "Qu\xE1 tr\xECnh hi\u1EC7n th\u1EF1c h\xF3a"
    titleVN: "Qu\xE1 tr\xECnh hi\u1EC7n th\u1EF1c h\xF3a"
    contentVN: "\u0110\u1ED1i t\u01B0\u1EE3ng nghi\xEAn c\u1EE9u c\u1EE7a m\xF4n h\u1ECDc c\xF2n l\xE0 qu\xE1 tr\xECnh h\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m c\u1EE7a H\u1ED3 Ch\xED Minh v\u1EADn \u0111\u1ED9ng trong th\u1EF1c ti\u1EC5n. Hay n\xF3i c\xE1ch kh\xE1c, \u0111\xF3 l\xE0 qu\xE1 tr\xECnh \"hi\u1EC7n th\u1EF1c h\xF3a\" h\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m c\u1EE7a H\u1ED3 Ch\xED Minh trong qu\xE1 tr\xECnh ph\xE1t tri\u1EC3n c\u1EE7a d\xE2n t\u1ED9c Vi\u1EC7t Nam.\n\nTrong qu\xE1 tr\xECnh hi\u1EC7n th\u1EF1c h\xF3a h\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m c\u1EE7a H\u1ED3 Ch\xED Minh, c\xE1ch m\u1EA1ng Vi\u1EC7t Nam lu\xF4n v\u1EADn d\u1EE5ng v\xE0 ph\xE1t tri\u1EC3n s\xE1ng t\u1EA1o h\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m \u0111\xF3 trong nh\u1EEFng \u0111i\u1EC1u ki\u1EC7n m\u1EDBi. (Gi\xE1o tr\xECnh 2021, tr.20)"
    exampleVN: 
    takeawayVN: "\u0110\u1ED1i t\u01B0\u1EE3ng nghi\xEAn c\u1EE9u g\u1ED3m hai ph\u1EA7n: h\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m trong di s\u1EA3n v\xE0 qu\xE1 tr\xECnh hi\u1EC7n th\u1EF1c h\xF3a h\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m \u1EA5y."
    content: "\u0110\u1ED1i t\u01B0\u1EE3ng nghi\xEAn c\u1EE9u c\u1EE7a m\xF4n h\u1ECDc c\xF2n l\xE0 qu\xE1 tr\xECnh h\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m c\u1EE7a H\u1ED3 Ch\xED Minh v\u1EADn \u0111\u1ED9ng trong th\u1EF1c ti\u1EC5n. Hay n\xF3i c\xE1ch kh\xE1c, \u0111\xF3 l\xE0 qu\xE1 tr\xECnh \"hi\u1EC7n th\u1EF1c h\xF3a\" h\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m c\u1EE7a H\u1ED3 Ch\xED Minh trong qu\xE1 tr\xECnh ph\xE1t tri\u1EC3n c\u1EE7a d\xE2n t\u1ED9c Vi\u1EC7t Nam.\n\nTrong qu\xE1 tr\xECnh hi\u1EC7n th\u1EF1c h\xF3a h\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m c\u1EE7a H\u1ED3 Ch\xED Minh, c\xE1ch m\u1EA1ng Vi\u1EC7t Nam lu\xF4n v\u1EADn d\u1EE5ng v\xE0 ph\xE1t tri\u1EC3n s\xE1ng t\u1EA1o h\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m \u0111\xF3 trong nh\u1EEFng \u0111i\u1EC1u ki\u1EC7n m\u1EDBi. (Gi\xE1o tr\xECnh 2021, tr.20)"
    example: 
    takeaway: "\u0110\u1ED1i t\u01B0\u1EE3ng nghi\xEAn c\u1EE9u g\u1ED3m hai ph\u1EA7n: h\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m trong di s\u1EA3n v\xE0 qu\xE1 tr\xECnh hi\u1EC7n th\u1EF1c h\xF3a h\u1EC7 th\u1ED1ng quan \u0111i\u1EC3m \u1EA5y."
