  m_Name: ch3-b3
  m_EditorClassIdentifier: Assembly-CSharp::CampusRift.Learning.LessonData
  id: ch3-b3
  title: "Quan h\u1EC7 gi\u1EEFa \u0111\u1ED9c l\u1EADp d\xE2n t\u1ED9c v\xE0 ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i"
  topic: "Quan h\u1EC7 gi\u1EEFa \u0111\u1ED9c l\u1EADp d\xE2n t\u1ED9c v\xE0 ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i"
  titleVN: "Quan h\u1EC7 gi\u1EEFa \u0111\u1ED9c l\u1EADp d\xE2n t\u1ED9c v\xE0 ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i"
  pages:
  - title: "\u0110\u1ED9c l\u1EADp d\xE2n t\u1ED9c v\xE0 ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i g\u1EAFn b\xF3 v\u1EDBi nhau"
    titleVN: "\u0110\u1ED9c l\u1EADp d\xE2n t\u1ED9c v\xE0 ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i g\u1EAFn b\xF3 v\u1EDBi nhau"
    contentVN: "\u0110\u1ED9c l\u1EADp d\xE2n t\u1ED9c l\xE0 c\u01A1 s\u1EDF, ti\u1EC1n \u0111\u1EC1 \u0111\u1EC3 ti\u1EBFn l\xEAn ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i. Trong Ch\xE1nh c\u01B0\u01A1ng v\u1EAFn t\u1EAFt c\u1EE7a \u0110\u1EA3ng (n\u0103m 1930), H\u1ED3 Ch\xED Minh kh\u1EB3ng \u0111\u1ECBnh ph\u01B0\u01A1ng h\u01B0\u1EDBng chi\u1EBFn l\u01B0\u1EE3c l\xE0 \"l\xE0m t\u01B0 s\u1EA3n d\xE2n quy\u1EC1n c\xE1ch m\u1EA1ng v\xE0 th\u1ED5 \u0111\u1ECBa c\xE1ch m\u1EA1ng \u0111\u1EC3 \u0111i t\u1EDBi x\xE3 h\u1ED9i c\u1ED9ng s\u1EA3n\": gi\u1EA3i ph\xF3ng d\xE2n t\u1ED9c l\xE0 m\u1EE5c ti\xEAu \u0111\u1EA7u ti\xEAn, l\xE0 c\u01A1 s\u1EDF cho m\u1EE5c ti\xEAu ti\u1EBFp theo l\xE0 ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i v\xE0 ch\u1EE7 ngh\u0129a c\u1ED9ng s\u1EA3n. \u0110\u1ED9c l\u1EADp d\xE2n t\u1ED9c kh\xF4ng ph\u1EA3i m\u1EE5c ti\xEAu cu\u1ED1i c\xF9ng m\xE0 l\xE0 ti\u1EC1n \u0111\u1EC1 cho c\xE1ch m\u1EA1ng x\xE3 h\u1ED9i ch\u1EE7 ngh\u0129a; c\xE1ch m\u1EA1ng d\xE2n t\u1ED9c d\xE2n ch\u1EE7 nh\xE2n d\xE2n c\xE0ng s\xE2u s\u1EAFc, tri\u1EC7t \u0111\u1EC3 th\xEC c\xE0ng t\u1EA1o ti\u1EC1n \u0111\u1EC1 thu\u1EADn l\u1EE3i cho c\xE1ch m\u1EA1ng x\xE3 h\u1ED9i ch\u1EE7 ngh\u0129a. C\xE1ch m\u1EA1ng gi\u1EA3i ph\xF3ng d\xE2n t\u1ED9c \u1EDF Vi\u1EC7t Nam \u0111i theo con \u0111\u01B0\u1EDDng c\xE1ch m\u1EA1ng v\xF4 s\u1EA3n n\xEAn ngay t\u1EEB \u0111\u1EA7u mang t\xEDnh \u0111\u1ECBnh h\u01B0\u1EDBng x\xE3 h\u1ED9i ch\u1EE7 ngh\u0129a.\n\nNg\u01B0\u1EE3c l\u1EA1i, ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i l\xE0 \u0111i\u1EC1u ki\u1EC7n b\u1EA3o \u0111\u1EA3m n\u1EC1n \u0111\u1ED9c l\u1EADp d\xE2n t\u1ED9c v\u1EEFng ch\u1EAFc. N\u0103m 1960, Ng\u01B0\u1EDDi kh\u1EB3ng \u0111\u1ECBnh: ch\u1EC9 c\xF3 ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i, ch\u1EE7 ngh\u0129a c\u1ED9ng s\u1EA3n m\u1EDBi gi\u1EA3i ph\xF3ng \u0111\u01B0\u1EE3c c\xE1c d\xE2n t\u1ED9c b\u1ECB \xE1p b\u1EE9c v\xE0 nh\u1EEFng ng\u01B0\u1EDDi lao \u0111\u1ED9ng tr\xEAn th\u1EBF gi\u1EDBi kh\u1ECFi \xE1ch n\xF4 l\u1EC7. Ch\u1EBF \u0111\u1ED9 d\xE2n ch\u1EE7 \u0111\u01B0\u1EE3c th\u1EC3 ch\u1EBF h\xF3a b\u1EB1ng ph\xE1p lu\u1EADt l\xE0 \u0111i\u1EC1u ki\u1EC7n quan tr\u1ECDng nh\u1EA5t \u0111\u1EC3 b\u1EA3o \u0111\u1EA3m n\u1EC1n \u0111\u1ED9c l\u1EADp d\xE2n t\u1ED9c. Ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i hi\u1EC7n th\u1EF1c c\xF2n g\xF3p ph\u1EA7n h\u1EA1n ch\u1EBF chi\u1EBFn tranh phi ngh\u0129a, b\u1EA3o v\u1EC7 h\xF2a b\xECnh th\u1EBF gi\u1EDBi. (Gi\xE1o tr\xECnh 2021, tr.112-117)"
    exampleVN: 
    takeawayVN: "\u0110\u1ED9c l\u1EADp d\xE2n t\u1ED9c l\xE0 ti\u1EC1n \u0111\u1EC1 c\u1EE7a ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i; ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i l\xE0 \u0111i\u1EC1u ki\u1EC7n b\u1EA3o \u0111\u1EA3m \u0111\u1ED9c l\u1EADp d\xE2n t\u1ED9c v\u1EEFng ch\u1EAFc."
    content: "\u0110\u1ED9c l\u1EADp d\xE2n t\u1ED9c l\xE0 c\u01A1 s\u1EDF, ti\u1EC1n \u0111\u1EC1 \u0111\u1EC3 ti\u1EBFn l\xEAn ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i. Trong Ch\xE1nh c\u01B0\u01A1ng v\u1EAFn t\u1EAFt c\u1EE7a \u0110\u1EA3ng (n\u0103m 1930), H\u1ED3 Ch\xED Minh kh\u1EB3ng \u0111\u1ECBnh ph\u01B0\u01A1ng h\u01B0\u1EDBng chi\u1EBFn l\u01B0\u1EE3c l\xE0 \"l\xE0m t\u01B0 s\u1EA3n d\xE2n quy\u1EC1n c\xE1ch m\u1EA1ng v\xE0 th\u1ED5 \u0111\u1ECBa c\xE1ch m\u1EA1ng \u0111\u1EC3 \u0111i t\u1EDBi x\xE3 h\u1ED9i c\u1ED9ng s\u1EA3n\": gi\u1EA3i ph\xF3ng d\xE2n t\u1ED9c l\xE0 m\u1EE5c ti\xEAu \u0111\u1EA7u ti\xEAn, l\xE0 c\u01A1 s\u1EDF cho m\u1EE5c ti\xEAu ti\u1EBFp theo l\xE0 ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i v\xE0 ch\u1EE7 ngh\u0129a c\u1ED9ng s\u1EA3n. \u0110\u1ED9c l\u1EADp d\xE2n t\u1ED9c kh\xF4ng ph\u1EA3i m\u1EE5c ti\xEAu cu\u1ED1i c\xF9ng m\xE0 l\xE0 ti\u1EC1n \u0111\u1EC1 cho c\xE1ch m\u1EA1ng x\xE3 h\u1ED9i ch\u1EE7 ngh\u0129a; c\xE1ch m\u1EA1ng d\xE2n t\u1ED9c d\xE2n ch\u1EE7 nh\xE2n d\xE2n c\xE0ng s\xE2u s\u1EAFc, tri\u1EC7t \u0111\u1EC3 th\xEC c\xE0ng t\u1EA1o ti\u1EC1n \u0111\u1EC1 thu\u1EADn l\u1EE3i cho c\xE1ch m\u1EA1ng x\xE3 h\u1ED9i ch\u1EE7 ngh\u0129a. C\xE1ch m\u1EA1ng gi\u1EA3i ph\xF3ng d\xE2n t\u1ED9c \u1EDF Vi\u1EC7t Nam \u0111i theo con \u0111\u01B0\u1EDDng c\xE1ch m\u1EA1ng v\xF4 s\u1EA3n n\xEAn ngay t\u1EEB \u0111\u1EA7u mang t\xEDnh \u0111\u1ECBnh h\u01B0\u1EDBng x\xE3 h\u1ED9i ch\u1EE7 ngh\u0129a.\n\nNg\u01B0\u1EE3c l\u1EA1i, ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i l\xE0 \u0111i\u1EC1u ki\u1EC7n b\u1EA3o \u0111\u1EA3m n\u1EC1n \u0111\u1ED9c l\u1EADp d\xE2n t\u1ED9c v\u1EEFng ch\u1EAFc. N\u0103m 1960, Ng\u01B0\u1EDDi kh\u1EB3ng \u0111\u1ECBnh: ch\u1EC9 c\xF3 ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i, ch\u1EE7 ngh\u0129a c\u1ED9ng s\u1EA3n m\u1EDBi gi\u1EA3i ph\xF3ng \u0111\u01B0\u1EE3c c\xE1c d\xE2n t\u1ED9c b\u1ECB \xE1p b\u1EE9c v\xE0 nh\u1EEFng ng\u01B0\u1EDDi lao \u0111\u1ED9ng tr\xEAn th\u1EBF gi\u1EDBi kh\u1ECFi \xE1ch n\xF4 l\u1EC7. Ch\u1EBF \u0111\u1ED9 d\xE2n ch\u1EE7 \u0111\u01B0\u1EE3c th\u1EC3 ch\u1EBF h\xF3a b\u1EB1ng ph\xE1p lu\u1EADt l\xE0 \u0111i\u1EC1u ki\u1EC7n quan tr\u1ECDng nh\u1EA5t \u0111\u1EC3 b\u1EA3o \u0111\u1EA3m n\u1EC1n \u0111\u1ED9c l\u1EADp d\xE2n t\u1ED9c. Ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i hi\u1EC7n th\u1EF1c c\xF2n g\xF3p ph\u1EA7n h\u1EA1n ch\u1EBF chi\u1EBFn tranh phi ngh\u0129a, b\u1EA3o v\u1EC7 h\xF2a b\xECnh th\u1EBF gi\u1EDBi. (Gi\xE1o tr\xECnh 2021, tr.112-117)"
    example: 
    takeaway: "\u0110\u1ED9c l\u1EADp d\xE2n t\u1ED9c l\xE0 ti\u1EC1n \u0111\u1EC1 c\u1EE7a ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i; ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i l\xE0 \u0111i\u1EC1u ki\u1EC7n b\u1EA3o \u0111\u1EA3m \u0111\u1ED9c l\u1EADp d\xE2n t\u1ED9c v\u1EEFng ch\u1EAFc."
    illustration: {fileID: 0}
  - title: "Ba \u0111i\u1EC1u ki\u1EC7n b\u1EA3o \u0111\u1EA3m \u0111\u1ED9c l\u1EADp d\xE2n t\u1ED9c g\u1EAFn li\u1EC1n v\u1EDBi ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i"
    titleVN: "Ba \u0111i\u1EC1u ki\u1EC7n b\u1EA3o \u0111\u1EA3m \u0111\u1ED9c l\u1EADp d\xE2n t\u1ED9c g\u1EAFn li\u1EC1n v\u1EDBi ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i"
    contentVN: "M\u1ED9t l\xE0, ph\u1EA3i b\u1EA3o \u0111\u1EA3m vai tr\xF2 l\xE3nh \u0111\u1EA1o tuy\u1EC7t \u0111\u1ED1i c\u1EE7a \u0110\u1EA3ng C\u1ED9ng s\u1EA3n trong su\u1ED1t ti\u1EBFn tr\xECnh c\xE1ch m\u1EA1ng; kh\xF4ng c\xF3 s\u1EF1 l\xE3nh \u0111\u1EA1o c\u1EE7a \u0110\u1EA3ng th\xEC c\xE1ch m\u1EA1ng Vi\u1EC7t Nam kh\xF4ng th\u1EC3 \u0111i theo con \u0111\u01B0\u1EDDng c\xE1ch m\u1EA1ng v\xF4 s\u1EA3n v\xE0 kh\xF4ng th\u1EC3 gi\xE0nh \u0111\u01B0\u1EE3c \u0111\u1ED9c l\u1EADp d\xE2n t\u1ED9c.\n\nHai l\xE0, ph\u1EA3i c\u1EE7ng c\u1ED1 v\xE0 t\u0103ng c\u01B0\u1EDDng kh\u1ED1i \u0111\u1EA1i \u0111o\xE0n k\u1EBFt d\xE2n t\u1ED9c m\xE0 n\u1EC1n t\u1EA3ng l\xE0 kh\u1ED1i li\xEAn minh c\xF4ng - n\xF4ng, v\xEC \u0111\u1EA1i \u0111o\xE0n k\u1EBFt d\xE2n t\u1ED9c l\xE0 v\u1EA5n \u0111\u1EC1 c\xF3 \xFD ngh\u0129a chi\u1EBFn l\u01B0\u1EE3c, quy\u1EBFt \u0111\u1ECBnh s\u1EF1 th\xE0nh c\xF4ng c\u1EE7a c\xE1ch m\u1EA1ng.\n\nBa l\xE0, ph\u1EA3i \u0111o\xE0n k\u1EBFt, g\u1EAFn b\xF3 ch\u1EB7t ch\u1EBD v\u1EDBi c\xE1ch m\u1EA1ng th\u1EBF gi\u1EDBi, \u0111\u1EC3 t\u1EA1o s\u1EE9c m\u1EA1nh to l\u1EDBn cho c\xE1ch m\u1EA1ng v\xE0 g\xF3p ph\u1EA7n cho h\xF2a b\xECnh, \u0111\u1ED9c l\u1EADp, d\xE2n ch\u1EE7 v\xE0 ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i tr\xEAn th\u1EBF gi\u1EDBi.\n\nBa \u0111i\u1EC1u ki\u1EC7n tr\xEAn ph\u1EA3i \u0111\u01B0\u1EE3c b\u1EA3o \u0111\u1EA3m, g\u1EAFn b\xF3 ch\u1EB7t ch\u1EBD v\u1EDBi nhau. (Gi\xE1o tr\xECnh 2021, tr.117-118)"
    exampleVN: 
    takeawayVN: "Ba \u0111i\u1EC1u ki\u1EC7n: \u0110\u1EA3ng l\xE3nh \u0111\u1EA1o; \u0111\u1EA1i \u0111o\xE0n k\u1EBFt d\xE2n t\u1ED9c tr\xEAn n\u1EC1n t\u1EA3ng li\xEAn minh c\xF4ng - n\xF4ng; \u0111o\xE0n k\u1EBFt v\u1EDBi c\xE1ch m\u1EA1ng th\u1EBF gi\u1EDBi."
    content: "M\u1ED9t l\xE0, ph\u1EA3i b\u1EA3o \u0111\u1EA3m vai tr\xF2 l\xE3nh \u0111\u1EA1o tuy\u1EC7t \u0111\u1ED1i c\u1EE7a \u0110\u1EA3ng C\u1ED9ng s\u1EA3n trong su\u1ED1t ti\u1EBFn tr\xECnh c\xE1ch m\u1EA1ng; kh\xF4ng c\xF3 s\u1EF1 l\xE3nh \u0111\u1EA1o c\u1EE7a \u0110\u1EA3ng th\xEC c\xE1ch m\u1EA1ng Vi\u1EC7t Nam kh\xF4ng th\u1EC3 \u0111i theo con \u0111\u01B0\u1EDDng c\xE1ch m\u1EA1ng v\xF4 s\u1EA3n v\xE0 kh\xF4ng th\u1EC3 gi\xE0nh \u0111\u01B0\u1EE3c \u0111\u1ED9c l\u1EADp d\xE2n t\u1ED9c.\n\nHai l\xE0, ph\u1EA3i c\u1EE7ng c\u1ED1 v\xE0 t\u0103ng c\u01B0\u1EDDng kh\u1ED1i \u0111\u1EA1i \u0111o\xE0n k\u1EBFt d\xE2n t\u1ED9c m\xE0 n\u1EC1n t\u1EA3ng l\xE0 kh\u1ED1i li\xEAn minh c\xF4ng - n\xF4ng, v\xEC \u0111\u1EA1i \u0111o\xE0n k\u1EBFt d\xE2n t\u1ED9c l\xE0 v\u1EA5n \u0111\u1EC1 c\xF3 \xFD ngh\u0129a chi\u1EBFn l\u01B0\u1EE3c, quy\u1EBFt \u0111\u1ECBnh s\u1EF1 th\xE0nh c\xF4ng c\u1EE7a c\xE1ch m\u1EA1ng.\n\nBa l\xE0, ph\u1EA3i \u0111o\xE0n k\u1EBFt, g\u1EAFn b\xF3 ch\u1EB7t ch\u1EBD v\u1EDBi c\xE1ch m\u1EA1ng th\u1EBF gi\u1EDBi, \u0111\u1EC3 t\u1EA1o s\u1EE9c m\u1EA1nh to l\u1EDBn cho c\xE1ch m\u1EA1ng v\xE0 g\xF3p ph\u1EA7n cho h\xF2a b\xECnh, \u0111\u1ED9c l\u1EADp, d\xE2n ch\u1EE7 v\xE0 ch\u1EE7 ngh\u0129a x\xE3 h\u1ED9i tr\xEAn th\u1EBF gi\u1EDBi.\n\nBa \u0111i\u1EC1u ki\u1EC7n tr\xEAn ph\u1EA3i \u0111\u01B0\u1EE3c b\u1EA3o \u0111\u1EA3m, g\u1EAFn b\xF3 ch\u1EB7t ch\u1EBD v\u1EDBi nhau. (Gi\xE1o tr\xECnh 2021, tr.117-118)"
    example: 
    takeaway: "Ba \u0111i\u1EC1u ki\u1EC7n: \u0110\u1EA3ng l\xE3nh \u0111\u1EA1o; \u0111\u1EA1i \u0111o\xE0n k\u1EBFt d\xE2n t\u1ED9c tr\xEAn n\u1EC1n t\u1EA3ng li\xEAn minh c\xF4ng - n\xF4ng; \u0111o\xE0n k\u1EBFt v\u1EDBi c\xE1ch m\u1EA1ng th\u1EBF gi\u1EDBi."
