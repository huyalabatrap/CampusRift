    prompt: "M\u1EE5c ti\xEAu v\u1EC1 t\u01B0 t\u01B0\u1EDFng c\u1EE7a Ch\u01B0\u01A1ng 4 l\xE0 g\xEC?"
    explanation: "\u0110\xF3 l\xE0 m\u1EE5c ti\xEAu \"V\u1EC1 t\u01B0 t\u01B0\u1EDFng\" c\u1EE7a Ch\u01B0\u01A1ng 4."
    promptVN: "M\u1EE5c ti\xEAu v\u1EC1 t\u01B0 t\u01B0\u1EDFng c\u1EE7a Ch\u01B0\u01A1ng 4 l\xE0 g\xEC?"
    explanationVN: "\u0110\xF3 l\xE0 m\u1EE5c ti\xEAu \"V\u1EC1 t\u01B0 t\u01B0\u1EDFng\" c\u1EE7a Ch\u01B0\u01A1ng 4."
    options:
    - id: A
      text: "Tin t\u01B0\u1EDFng v\xE0o s\u1EF1 l\xE3nh \u0111\u1EA1o c\u1EE7a \u0110\u1EA3ng v\xE0 s\u1EF1 qu\u1EA3n l\xFD c\u1EE7a Nh\xE0 n\u01B0\u1EDBc trong giai \u0111o\u1EA1n kinh t\u1EBF th\u1ECB tr\u01B0\u1EDDng, h\u1ED9i nh\u1EADp, to\xE0n c\u1EA7u h\xF3a"
      textVN: "Tin t\u01B0\u1EDFng v\xE0o s\u1EF1 l\xE3nh \u0111\u1EA1o c\u1EE7a \u0110\u1EA3ng v\xE0 s\u1EF1 qu\u1EA3n l\xFD c\u1EE7a Nh\xE0 n\u01B0\u1EDBc trong giai \u0111o\u1EA1n kinh t\u1EBF th\u1ECB tr\u01B0\u1EDDng, h\u1ED9i nh\u1EADp, to\xE0n c\u1EA7u h\xF3a"
      side: 
