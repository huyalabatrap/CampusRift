      text: "Xem nh\u1EB9 Nh\xE0 n\u01B0\u1EDBc"
      textVN: "Xem nh\u1EB9 Nh\xE0 n\u01B0\u1EDBc"
      side: 
    - id: C
      text: "B\u1ECF qua ph\xE1p lu\u1EADt"
      textVN: "B\u1ECF qua ph\xE1p lu\u1EADt"
      side: 
