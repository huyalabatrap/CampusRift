      text: "Th\xE0nh th\u1EA1o m\u1ED9t ngh\u1EC1 th\u1EE7 c\xF4ng"
      textVN: "Th\xE0nh th\u1EA1o m\u1ED9t ngh\u1EC1 th\u1EE7 c\xF4ng"
      side: 
    - id: C
      text: "Gi\u1ECFi t\xEDnh to\xE1n"
      textVN: "Gi\u1ECFi t\xEDnh to\xE1n"
      side: 
