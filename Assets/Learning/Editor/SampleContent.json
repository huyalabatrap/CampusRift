            },
            {
              "id": "2",
              "text": "O(log n)"
            },
            {
              "id": "3",
              "text": "O(n squared)"
            }
          ],
          "correctOptionIds": [
            "0"
          ],
          "explanation": "A full scan performs work proportional to the number of items."
