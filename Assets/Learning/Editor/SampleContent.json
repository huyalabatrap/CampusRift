    {
      "id": "dfs",
      "title": "DFS and Backtracking",
      "pages": [
        {
          "title": "FIELD NOTES",
          "content": "Depth-first search follows a branch as far as possible, then backtracks to explore alternatives. An explicit stack or the call stack can track the active path. Keep a visited set in graphs with cycles.",
          "example": "For A -> B -> D and A -> C, DFS may visit A, B, D, C. The order depends on neighbor ordering; it does not prove D is nearer than C.",
          "takeaway": "DFS is useful for reachability and structural traversal. Basic DFS does not guarantee shortest paths."
        }
      ],
      "questions": [
        {
          "id": "dfs-1",
          "lessonId": "dfs",
          "topic": "DFS and Backtracking",
          "type": "single-choice",
          "difficulty": 1,
          "prompt": "Which structure can implement DFS?",
          "options": [
            {
              "id": "0",
              "text": "Stack"
            },
            {
              "id": "1",
              "text": "FIFO queue only"
            },
            {
              "id": "2",
              "text": "A single boolean"
            },
            {
              "id": "3",
              "text": "Sorted set only"
            }
          ],
          "correctOptionIds": [
            "0"
          ],
          "explanation": "DFS uses last-in, first-out behavior, often via recursive calls."
        },
        {
          "id": "dfs-2",
          "lessonId": "dfs",
          "topic": "DFS and Backtracking",
          "type": "single-choice",
          "difficulty": 1,
          "prompt": "What happens at a dead end?",
          "options": [
            {
              "id": "0",
              "text": "Backtrack to an earlier branching point"
            },
            {
              "id": "1",
              "text": "Delete the graph"
            },
            {
              "id": "2",
              "text": "Repeat forever"
            },
            {
              "id": "3",
              "text": "Jump to the closest vertex"
            }
          ],
          "correctOptionIds": [
            "0"
          ],
          "explanation": "Backtracking returns to the last point with an unexplored alternative."
        },
        {
          "id": "dfs-3",
          "lessonId": "dfs",
          "topic": "DFS and Backtracking",
          "type": "single-choice",
          "difficulty": 1,
          "prompt": "Does basic DFS guarantee shortest paths?",
          "options": [
            {
              "id": "0",
              "text": "No"
            },
            {
              "id": "1",
              "text": "Always"
            },
            {
              "id": "2",
              "text": "Only if implemented recursively"
            },
            {
              "id": "3",
              "text": "Only with a stack"
            }
          ],
          "correctOptionIds": [
            "0"
          ],
          "explanation": "DFS explores depth first, so it can find a longer route before a shorter one."
        },
        {
          "id": "dfs-4",
          "lessonId": "dfs",
          "topic": "DFS and Backtracking",
          "type": "single-choice",
          "difficulty": 1,
          "prompt": "Why can recursive DFS overflow?",
          "options": [
            {
              "id": "0",
              "text": "The active path may be too deep"
            },
            {
              "id": "1",
              "text": "The graph has a name"
            },
            {
              "id": "2",
              "text": "All edges weigh one"
            },
            {
              "id": "3",
              "text": "The queue is empty"
