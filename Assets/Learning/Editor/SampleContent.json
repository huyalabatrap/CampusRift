{
  "lessons": [
    {
      "id": "bfs",
      "title": "BFS Basics",
      "pages": [
        {
          "title": "FIELD NOTES",
          "content": "Breadth-first search explores a graph one layer at a time. Start at a source, mark it visited, then put it in a queue. Repeatedly remove the oldest vertex and add each unvisited neighbor. Mark a vertex when enqueuing it so cycles cannot enqueue it repeatedly.",
          "example": "A connects to B and C; B connects to D. Starting at A, a possible visit order is A, B, C, D. B and C are distance 1; D is distance 2.",
          "takeaway": "BFS uses a FIFO queue. It finds minimum edge counts in unweighted graphs, not minimum costs for arbitrary weighted edges."
        }
      ],
      "questions": [
        {
          "id": "bfs-1",
          "lessonId": "bfs",
          "topic": "BFS Basics",
          "type": "single-choice",
          "difficulty": 1,
          "prompt": "Which structure normally drives BFS?",
          "options": [
            {
              "id": "0",
              "text": "Queue"
            },
            {
              "id": "1",
              "text": "Stack"
            },
            {
              "id": "2",
              "text": "Heap"
            },
            {
              "id": "3",
              "text": "Sorted array"
            }
          ],
          "correctOptionIds": [
            "0"
          ],
          "explanation": "A queue processes vertices in first-in, first-out order, preserving layers."
        },
        {
          "id": "bfs-2",
          "lessonId": "bfs",
          "topic": "BFS Basics",
          "type": "single-choice",
          "difficulty": 1,
          "prompt": "When should BFS mark a neighbor visited?",
          "options": [
            {
              "id": "0",
              "text": "When it is enqueued"
            },
            {
              "id": "1",
              "text": "Only at the end"
            },
            {
              "id": "2",
              "text": "Never"
            },
            {
              "id": "3",
              "text": "After all its neighbors"
            }
          ],
          "correctOptionIds": [
            "0"
          ],
          "explanation": "Marking on enqueue prevents duplicate entries and repeated work on cycles."
        },
        {
          "id": "bfs-3",
          "lessonId": "bfs",
          "topic": "BFS Basics",
          "type": "single-choice",
          "difficulty": 1,
          "prompt": "What does BFS minimize in an unweighted graph?",
          "options": [
            {
              "id": "0",
              "text": "Number of edges from the source"
