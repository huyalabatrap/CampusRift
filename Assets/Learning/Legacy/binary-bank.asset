%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 97c44860054bc4e4181a9d76144a93fe, type: 3}
  m_Name: binary-bank
  m_EditorClassIdentifier: Assembly-CSharp::CampusRift.Learning.QuestionBankData
  questions:
  - id: binary-1
    type: single-choice
    lessonId: binary
    topic: Binary Search
    difficulty: 1
    tags: []
    prompt: What property does standard binary search require?
    explanation: Sorting makes it possible to discard a half based on the middle comparison.
    promptVN: "T\xECm ki\u1EBFm nh\u1ECB ph\xE2n chu\u1EA9n y\xEAu c\u1EA7u d\u1EEF li\u1EC7u c\xF3 t\xEDnh ch\u1EA5t g\xEC?"
    explanationVN: "D\u1EEF li\u1EC7u \u0111\xE3 s\u1EAFp x\u1EBFp cho ph\xE9p lo\u1EA1i b\u1ECF m\u1ED9t n\u1EEDa d\u1EF1a tr\xEAn ph\xE9p so s\xE1nh v\u1EDBi ph\u1EA7n t\u1EED gi\u1EEFa."
    options:
    - id: 0
      text: Sorted data
      textVN: "\u0110\xE3 \u0111\u01B0\u1EE3c s\u1EAFp x\u1EBFp"
    - id: 1
      text: Random data
      textVN: "C\xF3 th\u1EE9 t\u1EF1 ng\u1EABu nhi\xEAn"
    - id: 2
      text: All equal elements
      textVN: "M\u1ECDi ph\u1EA7n t\u1EED b\u1EB1ng nhau"
    - id: 3
      text: A graph
      textVN: "L\xE0 m\u1ED9t \u0111\u1ED3 th\u1ECB"
    correctOptionIds:
    - 0
  - id: binary-2
    type: single-choice
    lessonId: binary
    topic: Binary Search
    difficulty: 1
    tags: []
    prompt: Target is greater than the middle value. Search where?
    explanation: All elements on the left are no greater than the middle in ascending sorted data.
    promptVN: "Gi\xE1 tr\u1ECB c\u1EA7n t\xECm l\u1EDBn h\u01A1n ph\u1EA7n t\u1EED gi\u1EEFa. Ta t\xECm ti\u1EBFp \u1EDF \u0111\xE2u?"
    explanationVN: "Trong d\u1EEF li\u1EC7u s\u1EAFp x\u1EBFp t\u0103ng d\u1EA7n, m\u1ECDi ph\u1EA7n t\u1EED b\xEAn tr\xE1i kh\xF4ng l\u1EDBn h\u01A1n ph\u1EA7n t\u1EED gi\u1EEFa."
    options:
    - id: 0
      text: Right half
      textVN: "N\u1EEDa b\xEAn ph\u1EA3i"
    - id: 1
      text: Left half
      textVN: "N\u1EEDa b\xEAn tr\xE1i"
    - id: 2
      text: Both halves always
      textVN: "Lu\xF4n t\xECm c\u1EA3 hai n\u1EEDa"
    - id: 3
      text: Only the first item
      textVN: "Ch\u1EC9 ph\u1EA7n t\u1EED \u0111\u1EA7u ti\xEAn"
    correctOptionIds:
    - 0
  - id: binary-3
    type: single-choice
    lessonId: binary
    topic: Binary Search
    difficulty: 1
    tags: []
    prompt: How does the candidate interval change?
    explanation: Each comparison discards roughly half of the remaining candidates.
    promptVN: "Kho\u1EA3ng \u1EE9ng vi\xEAn thay \u0111\u1ED5i nh\u01B0 th\u1EBF n\xE0o?"
    explanationVN: "M\u1ED7i ph\xE9p so s\xE1nh lo\u1EA1i b\u1ECF kho\u1EA3ng m\u1ED9t n\u1EEDa s\u1ED1 \u1EE9ng vi\xEAn c\xF2n l\u1EA1i."
    options:
    - id: 0
      text: It roughly halves
      textVN: "Gi\u1EA3m c\xF2n kho\u1EA3ng m\u1ED9t n\u1EEDa"
    - id: 1
      text: It doubles
      textVN: "T\u0103ng g\u1EA5p \u0111\xF4i"
    - id: 2
      text: It stays unchanged
      textVN: "Kh\xF4ng \u0111\u1ED5i"
    - id: 3
      text: It loses exactly one every time
      textVN: "M\u1ED7i l\u1EA7n lu\xF4n gi\u1EA3m \u0111\xFAng m\u1ED9t ph\u1EA7n t\u1EED"
    correctOptionIds:
    - 0
  - id: binary-4
    type: single-choice
    lessonId: binary
    topic: Binary Search
    difficulty: 1
    tags: []
    prompt: What is binary search time on a random-access sorted array?
    explanation: Repeated halving takes logarithmically many steps.
    promptVN: "T\xECm ki\u1EBFm nh\u1ECB ph\xE2n tr\xEAn m\u1EA3ng \u0111\xE3 s\u1EAFp x\u1EBFp, truy c\u1EADp tr\u1EF1c ti\u1EBFp, c\xF3 \u0111\u1ED9 ph\u1EE9c t\u1EA1p n\xE0o?"
    explanationVN: "Vi\u1EC7c li\xEAn t\u1EE5c chia \u0111\xF4i c\u1EA7n s\u1ED1 b\u01B0\u1EDBc t\u0103ng theo logarit c\u1EE7a n."
    options:
    - id: 0
      text: O(log n)
      textVN: O(log n)
    - id: 1
      text: O(n squared)
      textVN: "O(n\xB2)"
    - id: 2
      text: O(n factorial)
      textVN: O(n!)
    - id: 3
      text: O(n) always
      textVN: "Lu\xF4n l\xE0 O(n)"
    correctOptionIds:
    - 0
  - id: binary-5
    type: single-choice
    lessonId: binary
    topic: Binary Search
    difficulty: 1
    tags: []
    prompt: When can an unsuccessful search stop?
    explanation: An empty interval means no remaining position can hold the target.
    promptVN: "Khi n\xE0o c\xF3 th\u1EC3 k\u1EBFt lu\u1EADn t\xECm ki\u1EBFm th\u1EA5t b\u1EA1i?"
    explanationVN: "Kho\u1EA3ng r\u1ED7ng ngh\u0129a l\xE0 kh\xF4ng c\xF2n v\u1ECB tr\xED n\xE0o c\xF3 th\u1EC3 ch\u1EE9a gi\xE1 tr\u1ECB c\u1EA7n t\xECm."
    options:
    - id: 0
      text: When the candidate interval is empty
      textVN: "Khi kho\u1EA3ng \u1EE9ng vi\xEAn r\u1ED7ng"
    - id: 1
      text: After the first comparison always
      textVN: "Lu\xF4n sau ph\xE9p so s\xE1nh \u0111\u1EA7u ti\xEAn"
    - id: 2
      text: Only after sorting again
      textVN: "Ch\u1EC9 sau khi s\u1EAFp x\u1EBFp l\u1EA1i"
    - id: 3
      text: Never
      textVN: "Kh\xF4ng bao gi\u1EDD"
    correctOptionIds:
    - 0
  - id: binary-6
    type: single-choice
    lessonId: binary
    topic: Binary Search
    difficulty: 1
    tags: []
    prompt: With inclusive bounds and target > middle, which update shrinks the interval?
    explanation: Excluding the already checked middle guarantees progress and avoids a stuck interval.
    promptVN: "V\u1EDBi bi\xEAn bao g\u1ED3m c\u1EA3 hai \u0111\u1EA7u v\xE0 gi\xE1 tr\u1ECB c\u1EA7n t\xECm > ph\u1EA7n t\u1EED gi\u1EEFa, c\u1EADp nh\u1EADt n\xE0o l\xE0m kho\u1EA3ng nh\u1ECF l\u1EA1i?"
    explanationVN: "Lo\u1EA1i b\u1ECF ph\u1EA7n t\u1EED gi\u1EEFa \u0111\xE3 ki\u1EC3m tra \u0111\u1EA3m b\u1EA3o thu\u1EADt to\xE1n ti\u1EBFn l\xEAn v\xE0 kh\xF4ng b\u1ECB m\u1EAFc k\u1EB9t."
    options:
    - id: 0
      text: low = mid + 1
      textVN: low = mid + 1
    - id: 1
      text: low = mid
      textVN: low = mid
    - id: 2
      text: high = mid + 1
      textVN: high = mid + 1
    - id: 3
      text: low = 0
      textVN: low = 0
    correctOptionIds:
    - 0
